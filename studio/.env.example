# Copy to .env. HF_TOKEN needs write access: it creates model repos and submits HF Jobs.
HF_TOKEN=
# Namespace for model repos and jobs (defaults to the token's user).
HF_NAMESPACE=

DATABASE_URL=postgresql://studio:studio@localhost:5433/studio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=studio
S3_SECRET_KEY=studio-secret
S3_BUCKET=studio-previews

# 1 = simulate HF Jobs locally (synthetic lerobot-train logs, no GPU, no cost).
STUDIO_FAKE_JOBS=0
# Docker image the job runs (lerobot-train, lerobot-edit-dataset).
STUDIO_JOB_IMAGE=huggingface/lerobot-gpu:latest
